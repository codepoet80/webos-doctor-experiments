description "Package Manager Service"

start on stopped finish
start on first-use-finished
start on started LunaSysMgr

pre-start script
   logger "org.webosinternals.ipkgservice upstart: script called"

   APPS=/media/cryptofs/apps

   # webOS CE: on the FIRST boot after a flash the cryptofs store both
   # mounts late (finish post-start) and starts empty — app-install has
   # not created $APPS yet when this pre-start runs, which silently
   # skipped every seeding block below (seen live: Preware with no feeds
   # until the next reboot). Waiting for the MOUNT was not enough: the
   # store appears in /proc/mounts ~100s before it accepts writes, and
   # every seeding block below is guarded by "[ -d /media/cryptofs/apps ]",
   # so they all no-op silently and this service never runs its pre-start
   # again (it had a single early trigger, and there is no second boot
   # any more). Probe for an actual WRITE, and log the outcome so a device
   # with no Preware feeds can be diagnosed from a log instead of guessed at.
   IPKGLOG=/var/log/ce-ipkg-seed.log
   i=0
   while [ $i -lt 60 ]; do
      if grep -q " /media/cryptofs " /proc/mounts && \
         mkdir -p $APPS/etc/ipkg $APPS/usr/lib/ipkg 2>/dev/null && \
         touch $APPS/etc/ipkg/.ce-probe 2>/dev/null; then
         rm -f $APPS/etc/ipkg/.ce-probe 2>/dev/null
         break
      fi
      sleep 5
      i=$((i+1))
   done
   if [ $i -ge 60 ]; then
      echo "$(date 2>/dev/null) cryptofs not writable -- ipkg seeding skipped" \
         >> $IPKGLOG 2>/dev/null
   else
      echo "$(date 2>/dev/null) cryptofs writable after $((i*5))s -- seeding" \
         >> $IPKGLOG 2>/dev/null
   fi

   # webOS CE: seed the ipkg config on first boot (the baked install
   # replays what Preware's postinst would have written to cryptofs)
   if [ -d /media/cryptofs/apps ] && [ ! -f $APPS/etc/ipkg/arch.conf ] ; then
      mkdir -p $APPS/etc/ipkg $APPS/usr/lib/ipkg/cache $APPS/usr/lib/ipkg/lists
      cp /etc/ipkg/arch.conf $APPS/etc/ipkg/arch.conf
      echo "src/gz optware http://ipkg.preware.net/feeds/optware/all" > $APPS/etc/ipkg/optware.conf
      echo "src/gz optware-armv7 http://ipkg.preware.net/feeds/optware/armv7" >> $APPS/etc/ipkg/optware.conf
      echo "src/gz precentral http://weboslives.eu/feeds/precentral" > $APPS/etc/ipkg/precentral-weboslives.conf
      echo "src/gz precentral http://weboslives.eu/feeds/wosa" > $APPS/etc/ipkg/wosa-appmuseum.conf.disabled
      echo "src/gz precentral-themes http://ipkg.preware.net/feeds/precentral-themes" > $APPS/etc/ipkg/precentral-themes.conf.disabled
      echo "src/gz pivotce http://feed.pivotce.com" > $APPS/etc/ipkg/pivotce.conf
      echo "src/gz prethemer http://www.prethemer.com/feeds/preware/themes" > $APPS/etc/ipkg/prethemer.conf.disabled
      echo "src/gz clock-themes http://webos-clock-themer.googlecode.com/svn/trunk/WebOS%20Clock%20Theme%20Builder/feed" > $APPS/etc/ipkg/clock-themes.conf.disabled
      echo "src/gz webosinternals http://ipkg.preware.net/feeds/webos-internals/all" > $APPS/etc/ipkg/webos-internals.conf
      echo "src/gz webosinternals-armv7 http://ipkg.preware.net/feeds/webos-internals/armv7" >> $APPS/etc/ipkg/webos-internals.conf
      echo "src/gz webos-patches http://ipkg.preware.net/feeds/webos-patches/3.0.5" > $APPS/etc/ipkg/webos-patches.conf
      echo "src/gz webos-kernels http://ipkg.preware.net/feeds/webos-kernels/3.0.5" > $APPS/etc/ipkg/webos-kernels.conf
      echo "src/gz woce http://ipkg.preware.net/feeds/woce" > $APPS/etc/ipkg/woce.conf
      echo "src/gz modernize http://stacks.webosarchive.org/feeds/modernize/ipkgs" > $APPS/etc/ipkg/modernize.conf
   fi
   if [ -d /media/cryptofs/apps ] && ! grep -q "^Package: org.webosinternals.preware$" $APPS/usr/lib/ipkg/status 2>/dev/null ; then
      mkdir -p $APPS/usr/lib/ipkg
      {
         echo ""
         echo "Package: org.webosinternals.preware"
         echo "Version: 1.9.19"
         echo "Depends: "
         echo "Status: install ok installed"
         echo "Architecture: arm"
         echo "Description: Preware"
         echo "Installed-Time: 1786992923"
         echo ""
      } >> $APPS/usr/lib/ipkg/status
   fi
   if [ -d /media/cryptofs/apps ] && ! grep -q "^Package: org.webosinternals.govnah$" $APPS/usr/lib/ipkg/status 2>/dev/null ; then
      mkdir -p $APPS/usr/lib/ipkg
      {
         echo ""
         echo "Package: org.webosinternals.govnah"
         echo "Version: 1.3.9"
         echo "Depends: "
         echo "Status: install ok installed"
         echo "Architecture: arm"
         echo "Description: Govnah"
         echo "Installed-Time: 1786897039"
         echo ""
      } >> $APPS/usr/lib/ipkg/status
   fi
   if [ -d /media/cryptofs/apps ] && ! grep -q "^Package: com.palm.synergy.generic$" $APPS/usr/lib/ipkg/status 2>/dev/null ; then
      mkdir -p $APPS/usr/lib/ipkg
      {
         echo ""
         echo "Package: com.palm.synergy.generic"
         echo "Version: 0.9.3"
         echo "Depends: "
         echo "Status: install ok installed"
         echo "Architecture: all"
         echo "Description: Synergy Revival shared runtime"
         echo "Installed-Time: 1786985660"
         echo ""
      } >> $APPS/usr/lib/ipkg/status
   fi

   # Remove erroneously large list database cache files
   [ ! -d $APPS/usr/lib/ipkg/lists ] || find $APPS/usr/lib/ipkg/lists -size +10240k -delete
   VERSION=3.0.5

   # Configure the webos-patches feed
   if [ -f $APPS/etc/ipkg/webos-patches.conf ] ; then
      echo "src/gz webos-patches http://ipkg.preware.net/feeds/webos-patches/${VERSION:-unknown}" > $APPS/etc/ipkg/webos-patches.conf
   fi  
   if [ -f $APPS/etc/ipkg/webos-patches.conf.disabled ] ; then
      echo "src/gz webos-patches http://ipkg.preware.net/feeds/webos-patches/${VERSION:-unknown}" > $APPS/etc/ipkg/webos-patches.conf.disabled
   fi  

   # Configure the alpha-patches feed
   if [ -f $APPS/etc/ipkg/alpha-patches.conf ] ; then
      echo "src/gz alpha-patches http://ipkg.preware.net/alpha/patches/${VERSION:-unknown}" > $APPS/etc/ipkg/alpha-patches.conf
   fi  
   if [ -f $APPS/etc/ipkg/alpha-patches.conf.disabled ] ; then
      echo "src/gz alpha-patches http://ipkg.preware.net/alpha/patches/${VERSION:-unknown}" > $APPS/etc/ipkg/alpha-patches.conf.disabled
   fi  

   # Configure the beta-patches feed
   if [ -f $APPS/etc/ipkg/beta-patches.conf ] ; then
      echo "src/gz beta-patches http://ipkg.preware.net/beta/patches/${VERSION:-unknown}" > $APPS/etc/ipkg/beta-patches.conf
   fi  
   if [ -f $APPS/etc/ipkg/beta-patches.conf.disabled ] ; then
      echo "src/gz beta-patches http://ipkg.preware.net/beta/patches/${VERSION:-unknown}" > $APPS/etc/ipkg/beta-patches.conf.disabled
   fi  

   # Configure the webos-kernels feed
   if [ -f $APPS/etc/ipkg/webos-kernels.conf ] ; then
      echo "src/gz webos-kernels http://ipkg.preware.net/feeds/webos-kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/webos-kernels.conf
   fi  
   if [ -f $APPS/etc/ipkg/webos-kernels.conf.disabled ] ; then
      echo "src/gz webos-kernels http://ipkg.preware.net/feeds/webos-kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/webos-kernels.conf.disabled
   fi  

   # Configure the alpha-kernels feed
   if [ -f $APPS/etc/ipkg/alpha-kernels.conf ] ; then
      echo "src/gz alpha-kernels http://ipkg.preware.net/alpha/kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/alpha-kernels.conf
   fi  
   if [ -f $APPS/etc/ipkg/alpha-kernels.conf.disabled ] ; then
      echo "src/gz alpha-kernels http://ipkg.preware.net/alpha/kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/alpha-kernels.conf.disabled
   fi  

   # Configure the beta-kernels feed
   if [ -f $APPS/etc/ipkg/beta-kernels.conf ] ; then
      echo "src/gz beta-kernels http://ipkg.preware.net/beta/kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/beta-kernels.conf
   fi  
   if [ -f $APPS/etc/ipkg/beta-kernels.conf.disabled ] ; then
      echo "src/gz beta-kernels http://ipkg.preware.net/beta/kernels/${VERSION:-unknown}" > $APPS/etc/ipkg/beta-kernels.conf.disabled
   fi  

end script

exec /usr/sbin/org.webosinternals.ipkgservice

respawn
