# ce-firstboot-tweaks — webOS CE: (a) point the default-wallpaper entries in
# hp.tar's customization.json at a CE wallpaper before the customization
# service runs them; (b) once per flash, drop stale /media/cryptofs copies of
# apps this image bakes into the rootfs (cryptofs survives Doctor flashes and
# a stale copy shadows the baked app).
#
# (a) must stay EARLY and has no cryptofs dependency — the customization
# service reads that file on this same boot. (b) writes to cryptofs, which
# is mounted ~100s before it accepts writes on a fresh flash: this job fires
# on `stopped configurator`, which happens inside that window (seen live on
# 600011: flag written at 18:29, cryptofs not writable until ~18:30). Every
# rm would then fail silently and the flag would be set anyway, leaving a
# previous install's Preware/Govnah/core-app copies shadowing the baked ones
# forever — and with a no-reboot OOBE there is no second boot to repair it.
# So (b) waits for a real write, verifies each removal, and only flags when
# the store is clean. See ce-cryptofs-seed for the same pattern.

start on stopped configurator
start on first-use-finished

console none

script
    CUSTO=/usr/lib/luna/customization/customization.json
    if [ -f "$CUSTO" ] && grep -q 'wallpapers/01.jpg' "$CUSTO"; then
        # ce-remove-preloads fires on this same event and also flips /
        # rw->ro; take the shared lock so neither remounts under the other.
        L=/tmp/.ce-rootfs-rw.lock
        n=0
        while ! mkdir $L 2>/dev/null && [ $n -lt 60 ]; do sleep 1; n=$((n+1)); done
        mount -o remount,rw / 2>/dev/null || true
        sed -i 's|/01\.jpg|/22.png|g; s|"01\.jpg"|"22.png"|g' "$CUSTO"
        mount -o remount,ro / 2>/dev/null || true
        rmdir $L 2>/dev/null || true
        grep -q '22.png' "$CUSTO" \
            || echo "$(date 2>/dev/null) FAILED to patch customization.json" \
                 >> /var/log/ce-firstboot-tweaks.log 2>/dev/null
    fi
    FLAG=/var/luna/preferences/ce-cryptofs-deshadowed
    LOG=/var/log/ce-firstboot-tweaks.log
    log() { echo "$(date 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }
    APPS=/media/cryptofs/apps
    # Once per flash, and it MUST stay that way: after this runs, the user
    # is free to install or update these apps from a feed, and those land in
    # exactly the cryptofs paths swept below — a per-boot sweep would delete
    # the user's own Preware/Govnah updates on every reboot. What changed is
    # WHEN the flag is set: only after the sweep is verified, so a run that
    # finds cryptofs unwritable does not burn the one chance and leave a
    # previous install shadowing the baked apps forever.
    if [ -f "$FLAG" ]; then exit 0; fi
    i=0
    while [ $i -lt 60 ]; do
        grep -q " /media/cryptofs " /proc/mounts && \
           mkdir -p /media/cryptofs/.ce-deshadow-probe 2>/dev/null && \
           touch /media/cryptofs/.ce-deshadow-probe/w 2>/dev/null && break
        sleep 5
        i=$((i+1))
    done
    rm -rf /media/cryptofs/.ce-deshadow-probe 2>/dev/null
    if [ $i -ge 60 ]; then
        log "cryptofs not writable -- deshadow deferred to the next trigger"
        exit 0
    fi
    left=0
    found=0
    for app in com.palm.app.maps com.palm.app.enyo-findapps org.webosinternals.preware org.webosinternals.govnah com.webosarchive.usbsettings org.webosarchive.btgamepad com.palm.app.contacts com.palm.app.messaging com.palm.app.cloud-auth; do
        [ -d "$APPS/usr/palm/applications/$app" ] || continue
        found=$((found+1))
        rm -rf "$APPS/usr/palm/applications/$app"
        rm -f "$APPS/usr/lib/ipkg/info/$app".*
        [ -f "$APPS/usr/lib/ipkg/status" ] && sed -i "/^Package: $app\$/,/^\$/d" "$APPS/usr/lib/ipkg/status" || true
        if [ -d "$APPS/usr/palm/applications/$app" ]; then
            log "FAILED to deshadow $app -- it still shadows the baked app"
            left=$((left+1))
        else
            log "deshadowed stale $app"
        fi
    done
    if [ $left -eq 0 ]; then
        log "deshadow verified clean ($found stale copy(ies) removed)"
        mkdir -p /var/luna/preferences && touch "$FLAG"
    else
        log "$left stale copy(ies) remain -- NOT flagging, will retry"
    fi
end script
