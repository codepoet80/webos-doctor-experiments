# ce-cryptofs-seed — webOS CE: content that must live on /media/cryptofs
# (which survives flashes but is NOT in the image): the Synergy transport's
# glibc/runtime/plugins (hardcoded ELF interpreter path + imwrap.sh's bind
# mounts — a contract Preware-installed connectors rely on) and additions to
# the cryptofs app store (LunaCE tweak definitions).
#
# Hardened after a real failure: (a) a bare [ -d /media/cryptofs ] passes on
# the UNMOUNTED mountpoint, so gate on /proc/mounts and poll — cryptofs
# mounts late in boot; (b) the once-per-flash /var flag is NOT proof the
# content exists — cryptofs can be re-initialized underneath it (a dirty
# hard reboot makes setup_cryptofs rebuild the store), so ALSO self-heal
# every boot by copying any seed file missing from the target (cheap: just
# stats when nothing is missing). The flag alone still forces one full
# overwrite per flash so a re-flash refreshes changed files. Finally, kick
# imtransport in case it exhausted its respawn limit waiting on the seed.
#
# Hardened again after flash 600009 lost the ENTIRE seed on first boot:
# on a fresh flash /media/cryptofs appears in /proc/mounts ~100s before the
# store actually accepts writes, so every mkdir/cp in that window failed and
# the job still exited 0 and set the flag (the ipkg seeding in
# org.webosinternals.ipkgservice's pre-start died in the same window — that
# is the real cause of "Preware has no feeds until the next reboot").
# A second boot always repaired it, which is why this only surfaced once the
# OOBE stopped rebooting. So: (1) probe for an actual WRITE, not just the
# mount; (2) VERIFY every seed file landed and retry if not; (3) only set the
# flag once verified; (4) log to $LOG — a silent job cannot be diagnosed;
# (5) also run at first-use-finished, which is always well clear of the
# window. Cross-check: any CE job writing to cryptofs needs this gate.

start on stopped finish
start on first-use-finished
# Third chance on purpose: the first-use-finished emit is backgrounded from
# a LunaSysMgr that immediately calls exit(0), so it is fire-and-forget and
# can be lost -- and this job is the one everything else depends on.
# `started LunaSysMgr` comes from upstart's own bookkeeping and cannot be.
start on started LunaSysMgr

console none

script
    SEED=/usr/palm/ce-seed/cryptofs
    FLAG=/var/luna/preferences/ce-cryptofs-seeded
    LOG=/var/log/ce-cryptofs-seed.log
    log() { echo "$(date 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }
    # Two other jobs depend on this one and have no retry of their own, so
    # kick them on EVERY exit path -- they used to sit after the early
    # `exit 0`s, which silently forfeited Preware's feeds and the Synergy
    # transport whenever the seed bailed.
    #
    # SPLIT (600018 live finding): these two kicks have completely
    # different dependencies, and bundling them cost Preware 86 seconds.
    # kick_ipkg only needs cryptofs to be WRITABLE -- the feed configs are
    # ~1KB of echo. kick_imtransport needs the 31MB synergy payload to be
    # fully copied (its ELF interpreter lives there). Bundled at the end of
    # the job, the feeds were held hostage by a copy they do not depend on:
    # on 600018 OOBE finished 14:00:09, the user opened Preware 14:00:56 to
    # an empty feed list, and the configs were not written until 14:01:35.
    # (Why they need rewriting at all: ipkgservice's own pre-start DID seed
    # them at 13:55:18, but the cryptofs store is re-initialized during
    # first-use, which wiped them -- and its job was already running, so no
    # trigger ever re-ran that pre-start. This kick is the only repair.)
    kick_ipkg() {
        if [ ! -f /media/cryptofs/apps/etc/ipkg/arch.conf ]; then
            log "ipkg config absent -- restarting ipkgservice to re-seed"
            /sbin/initctl stop org.webosinternals.ipkgservice > /dev/null 2>&1 || true
            /sbin/initctl start org.webosinternals.ipkgservice > /dev/null 2>&1 || true
        fi
    }
    kick_imtransport() {
        /sbin/initctl start imtransport > /dev/null 2>&1 || true
    }
    kick_dependents() { kick_ipkg; kick_imtransport; }
    if [ ! -d "$SEED" ]; then kick_dependents; exit 0; fi
    # Do NOTHING until first use is finished, and get out of the way FAST.
    # The cryptofs store is re-initialized during first-use, so anything
    # seeded before that is wiped -- the work is not merely wasted, it is
    # actively harmful: this job's 5-attempt retry loop takes minutes, and
    # while it runs upstart considers the job RUNNING and silently DROPS
    # the `start on first-use-finished` trigger, which is the one run that
    # would have stuck. Seen live on 600019: job started 14:45:45, still
    # looping when first-use-finished fired at 14:52:54 (upstart started
    # ce-language-patches on that event and not this job), so NOTHING was
    # ever seeded -- no feeds, no stanzas, no synergy runtime. 600018 only
    # escaped because its early run happened to die after 48s, leaving the
    # job idle in time to catch the trigger. Exiting immediately makes that
    # luck into a guarantee. On later (post-OOBE) boots the flag exists, so
    # the ordinary `stopped finish` self-heal pass still runs.
    if [ ! -f /var/luna/preferences/ran-first-use ]; then
        log "first use not finished -- deferring to first-use-finished"
        exit 0
    fi
    i=0
    while ! grep -q " /media/cryptofs " /proc/mounts && [ $i -lt 60 ]; do
        sleep 5
        i=$((i+1))
    done
    if ! grep -q " /media/cryptofs " /proc/mounts; then
        log "cryptofs never mounted -- nothing seeded"
        kick_dependents
        exit 0
    fi
    # mounted != writable: poll until the store really takes a write
    i=0
    while [ $i -lt 60 ]; do
        if mkdir -p /media/cryptofs/.ce-seed-probe 2>/dev/null \
           && touch /media/cryptofs/.ce-seed-probe/w 2>/dev/null; then
            rm -rf /media/cryptofs/.ce-seed-probe 2>/dev/null
            break
        fi
        sleep 5
        i=$((i+1))
    done
    if [ $i -ge 60 ]; then
        log "cryptofs mounted but never writable -- nothing seeded"
        kick_dependents
        exit 0
    fi
    log "cryptofs writable after $((i*5))s of probing"
    # FIRST, before the big copy: repair the ipkg feed config. This is the
    # difference between Preware working the moment the user reaches the
    # launcher and Preware looking broken for a minute and a half.
    kick_ipkg
    attempt=0
    while [ $attempt -lt 5 ]; do
        attempt=$((attempt+1))
        if [ ! -f "$FLAG" ]; then
            # fresh flash (or /var wiped): full overwrite with image content
            for d in "$SEED"/*; do
                [ -d "$d" ] || continue
                b=$(basename "$d")
                mkdir -p "/media/cryptofs/$b" || log "mkdir failed: $b"
                cp -rf "$d/." "/media/cryptofs/$b/" || log "cp failed: $b"
            done
        fi
        # restore anything still missing, then VERIFY the whole seed landed
        cd "$SEED"
        # SIZE, not existence: a cp that dies mid-write leaves a truncated
        # file that passes [ -f ] and then SIGBUSes the transport in
        # ld-linux when it mmaps a library shorter than its headers claim.
        find . -type f | while IFS= read -r f; do
            rel=${f#./}
            if [ "$(wc -c < "$f" 2>/dev/null)" != "$(wc -c < "/media/cryptofs/$rel" 2>/dev/null)" ]; then
                mkdir -p "/media/cryptofs/$(dirname "$rel")" 2>/dev/null
                cp -f "$f" "/media/cryptofs/$rel" 2>/dev/null
            fi
        done
        missing=$(find . -type f | while IFS= read -r f; do
            [ "$(wc -c < "$f" 2>/dev/null)" = "$(wc -c < "/media/cryptofs/${f#./}" 2>/dev/null)" ] || echo x
        done | wc -l)
        if [ "$missing" -eq 0 ]; then
            log "seed verified complete on attempt $attempt"
            mkdir -p /var/luna/preferences && touch "$FLAG"
            break
        fi
        log "attempt $attempt: $missing seed file(s) still missing -- retrying"
        sleep 10
    done
    kick_dependents
end script
