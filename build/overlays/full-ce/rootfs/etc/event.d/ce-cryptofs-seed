# ce-cryptofs-seed — webOS CE: content that must live on /media/cryptofs
# (which survives flashes but is NOT in the image): the Synergy transport's
# glibc/runtime/plugins (hardcoded ELF interpreter path + imwrap.sh's bind
# mounts — a contract Preware-installed connectors rely on) and additions to
# the cryptofs app store (LunaCE tweak definitions).
#
# Hardened after a real failure: (a) a bare [ -d /media/cryptofs ] passes on
# the UNMOUNTED mountpoint, so gate on /proc/mounts and poll — cryptofs
# mounts late in boot; (b) the once-per-flash /var flag is NOT proof the
# content exists — cryptofs can be re-initialized underneath it (a dirty
# hard reboot makes setup_cryptofs rebuild the store), so ALSO self-heal
# every boot by copying any seed file missing from the target (cheap: just
# stats when nothing is missing). The flag alone still forces one full
# overwrite per flash so a re-flash refreshes changed files. Finally, kick
# imtransport in case it exhausted its respawn limit waiting on the seed.
#
# Hardened again after flash 600009 lost the ENTIRE seed on first boot:
# on a fresh flash /media/cryptofs appears in /proc/mounts ~100s before the
# store actually accepts writes, so every mkdir/cp in that window failed and
# the job still exited 0 and set the flag (the ipkg seeding in
# org.webosinternals.ipkgservice's pre-start died in the same window — that
# is the real cause of "Preware has no feeds until the next reboot").
# A second boot always repaired it, which is why this only surfaced once the
# OOBE stopped rebooting. So: (1) probe for an actual WRITE, not just the
# mount; (2) VERIFY every seed file landed and retry if not; (3) only set the
# flag once verified; (4) log to $LOG — a silent job cannot be diagnosed;
# (5) also run at first-use-finished, which is always well clear of the
# window. Cross-check: any CE job writing to cryptofs needs this gate.

start on stopped finish
start on first-use-finished

console none

script
    SEED=/usr/palm/ce-seed/cryptofs
    FLAG=/var/luna/preferences/ce-cryptofs-seeded
    LOG=/var/log/ce-cryptofs-seed.log
    log() { echo "$(date 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }
    if [ ! -d "$SEED" ]; then exit 0; fi
    i=0
    while ! grep -q " /media/cryptofs " /proc/mounts && [ $i -lt 60 ]; do
        sleep 5
        i=$((i+1))
    done
    if ! grep -q " /media/cryptofs " /proc/mounts; then
        log "cryptofs never mounted -- nothing seeded"
        exit 0
    fi
    # mounted != writable: poll until the store really takes a write
    i=0
    while [ $i -lt 60 ]; do
        if mkdir -p /media/cryptofs/.ce-seed-probe 2>/dev/null \
           && touch /media/cryptofs/.ce-seed-probe/w 2>/dev/null; then
            rm -rf /media/cryptofs/.ce-seed-probe 2>/dev/null
            break
        fi
        sleep 5
        i=$((i+1))
    done
    if [ $i -ge 60 ]; then
        log "cryptofs mounted but never writable -- nothing seeded"
        exit 0
    fi
    log "cryptofs writable after $((i*5))s of probing"
    attempt=0
    while [ $attempt -lt 5 ]; do
        attempt=$((attempt+1))
        if [ ! -f "$FLAG" ]; then
            # fresh flash (or /var wiped): full overwrite with image content
            for d in "$SEED"/*; do
                [ -d "$d" ] || continue
                b=$(basename "$d")
                mkdir -p "/media/cryptofs/$b" || log "mkdir failed: $b"
                cp -rf "$d/." "/media/cryptofs/$b/" || log "cp failed: $b"
            done
        fi
        # restore anything still missing, then VERIFY the whole seed landed
        cd "$SEED"
        find . -type f | while IFS= read -r f; do
            rel=${f#./}
            if [ ! -f "/media/cryptofs/$rel" ]; then
                mkdir -p "/media/cryptofs/$(dirname "$rel")" 2>/dev/null
                cp -f "$f" "/media/cryptofs/$rel" 2>/dev/null
            fi
        done
        missing=$(find . -type f | while IFS= read -r f; do
            [ -f "/media/cryptofs/${f#./}" ] || echo x
        done | wc -l)
        if [ "$missing" -eq 0 ]; then
            log "seed verified complete on attempt $attempt"
            mkdir -p /var/luna/preferences && touch "$FLAG"
            break
        fi
        log "attempt $attempt: $missing seed file(s) still missing -- retrying"
        sleep 10
    done
    # the ipkg feed/status seeding lives in ipkgservice's pre-start and dies
    # in the same window; restarting re-runs it (idempotent) now that writes
    # work -- without this Preware ships with no feeds and no seeded stanzas.
    if [ ! -f /media/cryptofs/apps/etc/ipkg/arch.conf ]; then
        log "ipkg config absent -- restarting ipkgservice to re-seed"
        /sbin/initctl stop org.webosinternals.ipkgservice > /dev/null 2>&1 || true
        /sbin/initctl start org.webosinternals.ipkgservice > /dev/null 2>&1 || true
    fi
    /sbin/initctl start imtransport > /dev/null 2>&1 || true
end script
