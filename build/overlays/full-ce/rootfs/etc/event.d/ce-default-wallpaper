# ce-default-wallpaper — webOS CE: make the CE wallpaper the out-of-box
# default. Only replaces the factory 01.jpg; any user choice is left alone.
# Triggers BOTH per boot and at first-use completion: the OOBE finishes
# without a reboot (markFirstUseDone + LunaSysMgr respawn), so a job that
# only ran on 'stopped finish' fired before first use and then never again
# (seen live: factory wallpaper survived a whole no-reboot flash).
#
# The flag is set ONLY after re-reading the preference and seeing the CE
# wallpaper actually stick. It used to be set unconditionally, outside the
# `if`, with both luna-send replies discarded — so an import that failed
# (or simply had not finished: lsq hard-kills the call after 4s, and the
# customization pass that copies the wallpaper into /media/internal runs
# CONCURRENTLY with this job's first-use-finished run) left the pref
# pointing at a file that was never imported, permanently, with no second
# boot to repair it. Also wait for the source file to exist before trying.
# Third trigger: `started LunaSysMgr` — the first-use-finished emit is
# fire-and-forget from a process calling exit(0), so it can be lost.

start on stopped finish
start on first-use-finished
start on started LunaSysMgr

console none

script
    [ -f /var/luna/preferences/ran-first-use ] || exit 0
    FLAG=/var/luna/preferences/ce-default-wallpaper
    LOG=/var/log/ce-default-wallpaper.log
    log() { echo "$(date 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }
    if [ -f "$FLAG" ]; then exit 0; fi
    lsq() {
        luna-send -n 1 "$1" "$2" > /tmp/ce-wp.out 2>/dev/null &
        P=$!
        sleep 4
        kill $P 2>/dev/null || true
        cat /tmp/ce-wp.out 2>/dev/null || true
    }
    R=""
    i=0
    while [ $i -lt 30 ]; do
        R=$(lsq palm://com.palm.systemservice/getPreferences '{"keys":["wallpaper"]}')
        if echo "$R" | grep -q wallpaperName; then break; fi
        sleep 4; i=$((i+1))
    done
    rm -f /tmp/ce-wp.out
    if ! echo "$R" | grep -q wallpaperName; then
        log "systemservice never answered -- retrying on the next trigger"
        exit 0
    fi
    if ! echo "$R" | grep -q '"01.jpg"'; then
        # not the factory default: either we already ran, or the user chose
        # their own. Either way leave it alone and stop asking.
        log "wallpaper is not the factory 01.jpg -- leaving it alone"
        mkdir -p /var/luna/preferences && touch "$FLAG"
        exit 0
    fi
    SRC=/media/internal/wallpapers/22.jpg
    i=0
    while [ ! -f "$SRC" ] && [ $i -lt 30 ]; do sleep 4; i=$((i+1)); done
    if [ ! -f "$SRC" ]; then
        log "$SRC not present yet -- retrying on the next trigger"
        exit 0
    fi
    lsq palm://com.palm.systemservice/wallpaper/importWallpaper '{"target":"/media/internal/wallpapers/22.jpg","scale":1.0}' >/dev/null
    lsq palm://com.palm.systemservice/setPreferences '{"wallpaper":{"wallpaperName":"22.jpg","wallpaperFile":"/media/internal/.wallpapers/22.jpg","wallpaperThumbFile":"/media/internal/.wallpapers/thumbs/22.jpg"}}' >/dev/null
    # verify it actually took before claiming the job is done
    V=$(lsq palm://com.palm.systemservice/getPreferences '{"keys":["wallpaper"]}')
    rm -f /tmp/ce-wp.out
    if echo "$V" | grep -q '"22.jpg"'; then
        log "default wallpaper set to 22.jpg"
        mkdir -p /var/luna/preferences && touch "$FLAG"
    else
        log "wallpaper did NOT stick (pref: $V) -- NOT flagging, will retry"
    fi
end script
