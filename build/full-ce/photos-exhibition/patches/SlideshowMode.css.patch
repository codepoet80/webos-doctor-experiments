--- a/css/SlideshowMode.css
+++ b/css/SlideshowMode.css
@@ -200,3 +200,52 @@
 .slideshow .enyo-button.enyo-button-down img.timer {
     margin-top: -35px;
 }
+
+/* exhibition-mode clock, lower-left.
+   text-shadow does not render in this context in ANY syntax (tried a comma list, a
+   zero-offset glow, colour-last and colour-first -- all invisible), so the drop shadow is
+   faked: each line is written twice, a black copy offset down-right and painted underneath,
+   with the white copy on top. Only position/colour/z-index are involved, so it cannot fail. */
+.slideshow .exhibition-clock {
+    position: absolute;
+    left: 70px;
+    bottom: 86px;
+    z-index: 900;
+    pointer-events: none;
+    white-space: nowrap;
+}
+
+.slideshow .exhibition-clock-line {
+    position: relative;
+}
+
+.slideshow .exhibition-clock .ec-shadow {
+    position: absolute;
+    left: 2px;
+    top: 2px;
+    z-index: 1;
+    color: #000000;
+}
+
+.slideshow .exhibition-clock .ec-fill {
+    position: relative;
+    z-index: 2;
+    color: #ffffff;
+}
+
+.slideshow .exhibition-clock-time {
+    font-size: 88px;
+    font-weight: 300;
+    line-height: 94px;
+    letter-spacing: -2px;
+}
+
+.slideshow .exhibition-clock-date {
+    font-size: 34px;
+    line-height: 42px;
+}
+
+/* toolbar button state: dimmed while the clock is hidden */
+.slideshow .enyo-button img.clock-off {
+    opacity: 0.35;
+}
