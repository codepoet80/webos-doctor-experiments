#!/bin/sh
# ce-ota-verify — verify a detached CE OTA signature.
#
#   ce-ota-verify <file> <sigfile> [pubkey]
#
# Exit 0  = signature is valid for <file> under <pubkey>.
# Exit 1  = REFUSE. Anything that is not an unambiguous success is a refusal:
#           bad signature, wrong key, missing file, unreadable key, no openssl.
#
# Deliberately uses the STOCK /usr/bin/openssl (0.9.8k, 2009) and NOT the
# community /usr/lib/ssl11 stack. Verified on hardware 2026-08-30 against
# webOS CE 3.1.0 (TestpadE): RSA-4096 + SHA-256 detached signatures verify
# correctly, and all three negative cases (tampered payload, wrong key,
# missing signature) exit 1. Because 0.9.8k is also what stock 3.0.5 ships,
# this same script works unchanged on 3.0.5 for OTA Ready v2 — no dependency
# on the TLS 1.3 suite being installed, which matters because a device may
# need to verify an update that has not yet modernised its crypto.
#
# Signature file may be base64 (preferred, travels well over HTTP alongside
# JSON) or raw DER. Both are tried; both must fail to refuse.

set -u

# Hard-coded on purpose. Do NOT make this overridable by the environment:
# redirecting the verifier's openssl would defeat the trust anchor. To test the
# script on a build host, copy it and substitute this line in the copy.
OPENSSL=/usr/bin/openssl
DEFAULT_KEY=/usr/share/ce-ota/keys/ce-ota-signing.pub

FILE="${1:-}"
SIG="${2:-}"
KEY="${3:-$DEFAULT_KEY}"

fail() { echo "ce-ota-verify: REFUSED: $*" >&2; exit 1; }

[ -n "$FILE" ] && [ -n "$SIG" ] || fail "usage: ce-ota-verify <file> <sigfile> [pubkey]"
[ -f "$FILE" ]   || fail "payload not found: $FILE"
[ -f "$SIG"  ]   || fail "signature not found: $SIG"
[ -f "$KEY"  ]   || fail "public key not found: $KEY"
[ -x "$OPENSSL" ] || fail "openssl not found at $OPENSSL"

# Private temp file. mktemp is not guaranteed on this busybox, so fall back to
# a noclobber create, which refuses to follow a pre-planted symlink in /tmp.
TMP=$(mktemp /tmp/ce-ota-verify.XXXXXX 2>/dev/null) || {
    TMP="/tmp/ce-ota-verify.$$"
    rm -f "$TMP"
    ( set -C; : > "$TMP" ) 2>/dev/null || fail "cannot create temp file"
}
trap 'rm -f "$TMP"' EXIT INT TERM

verify_with() {   # $1 = signature file in raw DER
    "$OPENSSL" dgst -sha256 -verify "$KEY" -signature "$1" "$FILE" >/dev/null 2>&1
}

# 1. Treat the signature as base64 and verify the decoded bytes.
if "$OPENSSL" enc -d -base64 -in "$SIG" -out "$TMP" 2>/dev/null && [ -s "$TMP" ]; then
    if verify_with "$TMP"; then
        exit 0
    fi
fi

# 2. Treat the signature as raw DER.
if verify_with "$SIG"; then
    exit 0
fi

fail "signature does not verify for $FILE"
